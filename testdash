#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["textual>=8.2,<9"]
# ///
"""testdash: pick tests, run them, and follow the results and every service the run starts.

  testdash [--task TASK] [--config FILE] [--show-test-output] [--all-containers] [ARG...] [-- COMMAND...]

In a Gradle build it lists every test task's tests (JUnit discovery, no build change) and runs the ones you
pick; ARGs are added to the Gradle command. Everything after `--` replaces the command. The containers the run
starts are found through Docker and get their own views, WireMock with its requests and stubs. See README.md.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
import uuid
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
sys.dont_write_bytecode = True  # no __pycache__ left in the checkout
# Textual switches the terminal to the kitty keyboard protocol and switches it back just before leaving the
# alternate screen. Terminals that keep one protocol setting for both screens (Orca's among them) stay switched,
# so after quitting the shell gets keys as codes ("13u" for Enter). testdash needs none of what the protocol adds.
# Read when Textual is imported, so it is set first.
os.environ.setdefault("TEXTUAL_DISABLE_KITTY_KEY", "1")

import catalog  # noqa: E402
from app import Settings, Testdash  # noqa: E402

CONFIG_NAME = ".testdash.json"


def main(argv: list[str]) -> int:
    options, explicit = (argv[:argv.index("--")], argv[argv.index("--") + 1:]) if "--" in argv else (argv, [])
    parser = argparse.ArgumentParser(prog="testdash", description=__doc__.split("\n\n")[0], allow_abbrev=False)
    parser.add_argument("--task", help="the Gradle test task to show first, e.g. :app:blackBoxTest")
    parser.add_argument("--config", type=Path, help=f"config file (default: the nearest {CONFIG_NAME})")
    parser.add_argument("--show-test-output", action="store_true",
                        help="keep test stdout in the Output view; by default the service views show it")
    parser.add_argument("--all-containers", action="store_true",
                        help="follow every running container, not only those the run starts")
    args, extra = parser.parse_known_args(options)

    config_path = args.config or _find_config(Path.cwd())
    config = json.loads(config_path.read_text(encoding="utf-8")) if config_path else {}
    command, workdir = None, Path.cwd()
    if explicit:
        command = explicit
    elif config.get("command"):
        configured = config["command"]
        command = configured.split() if isinstance(configured, str) else list(configured)
        workdir = Path.cwd() if args.config else config_path.parent  # a discovered config sits in its repo

    build_root = catalog.build_root(workdir)
    if command is None and build_root is not None:
        workdir = build_root
    run_dir = Path(tempfile.gettempdir()) / "testdash" / f"{workdir.name}-{uuid.uuid4().hex[:6]}"
    run_dir.mkdir(parents=True, exist_ok=True)
    settings = Settings(
        workdir=workdir,
        build_root=build_root,
        command=command,
        extra_args=extra,
        task=args.task or config.get("task"),
        show_test_output=args.show_test_output or bool(config.get("showTestOutput")),
        include_all_containers=args.all_containers,
        run_dir=run_dir,
        extra_logs=config.get("logs", []),
    )
    Testdash(settings).run()
    return 0


def _find_config(start: Path) -> Path | None:
    for directory in [start, *start.parents]:
        if (directory / CONFIG_NAME).is_file():
            return directory / CONFIG_NAME
        if (directory / ".git").exists():
            return None
    return None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
