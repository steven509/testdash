Set Shell zsh
Set FontFamily "Hack Nerd Font"
Set Padding 0
Set CursorBlink false
Set TypingSpeed 70ms
Set Theme { "name": "testdash", "background": "#12121C", "foreground": "#E4E4F0", "black": "#1A1A29", "red": "#F87171", "green": "#4ADE80", "yellow": "#FBBF24", "blue": "#60A5FA", "magenta": "#8B7CFF", "cyan": "#5EEAD4", "white": "#E4E4F0", "brightBlack": "#6B6B88", "brightRed": "#F87171", "brightGreen": "#4ADE80", "brightYellow": "#FBBF24", "brightBlue": "#60A5FA", "brightMagenta": "#F472B6", "brightCyan": "#5EEAD4", "brightWhite": "#FFFFFF", "cursor": "#8B7CFF", "selection": "#383848" }
