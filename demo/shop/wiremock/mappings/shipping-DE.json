{
  "name": "Quote shipping to DE",
  "request": { "method": "GET", "urlPath": "/shipping/quotes", "queryParameters": { "country": { "equalTo": "DE" } } },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "carrier": "DHL", "service": "Paket", "price": 7.50, "days": 3 },
    "delayDistribution": { "type": "uniform", "lower": 90, "upper": 260 }
  }
}
