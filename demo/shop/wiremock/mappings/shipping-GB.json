{
  "name": "Quote shipping to GB",
  "request": { "method": "GET", "urlPath": "/shipping/quotes", "queryParameters": { "country": { "equalTo": "GB" } } },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "carrier": "Royal Mail", "service": "Tracked 48", "price": 4.99, "days": 2 },
    "delayDistribution": { "type": "uniform", "lower": 90, "upper": 260 }
  }
}
